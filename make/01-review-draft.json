{
  "name": "HDH social — 1. Review draft",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 0,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "hdh-social-draft"
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "email:ActionSendEmail",
              "version": 6,
              "parameters": {
                "account": 0
              },
              "filter": {
                "name": "Payload completo (nessun segnaposto)",
                "conditions": [
                  [
                    {
                      "a": "{{1.schema_version}}",
                      "b": "1",
                      "o": "number:equal"
                    },
                    {
                      "a": "{{1.cta_keyword}}",
                      "b": "<",
                      "o": "text:notcontain"
                    }
                  ]
                ]
              },
              "mapper": {
                "to": [
                  "admin@giusivalentini.com"
                ],
                "subject": "HDH social — bozza da approvare — {{1.data_post}} — {{1.tesi}}",
                "contentType": "html",
                "html": "<h2>{{1.tesi}}</h2>\n<p><strong>{{1.data_post}}</strong> &middot; fonte: {{1.fonte}} &middot; stile: {{1.stile}} &middot; avatar: {{1.avatar}}</p>\n<p><a href=\"{{1.canva_design_url}}\">Apri il carosello in Canva</a> &middot; mese: {{1.mese_anno_tag}} &middot; keyword CTA: <code>{{1.cta_keyword}}</code></p>\n<hr>\n<h3>Instagram <em>(pubblicato in automatico)</em></h3><pre>{{1.captions.instagram.testo}}</pre>\n<h3>Facebook profilo <em>(da pubblicare a mano)</em></h3><pre>{{1.captions.facebook_profilo.testo}}</pre>\n<h3>Gruppo Podcast <em>(da pubblicare a mano)</em></h3><pre>{{1.captions.facebook_gruppo.testo}}</pre>\n<h3>YouTube <em>(da pubblicare a mano)</em></h3><pre>{{1.captions.youtube.testo}}</pre>\n<h3>Telegram <em>(pubblicato in automatico)</em></h3><pre>{{1.captions.telegram.testo}}</pre>\n<hr>\n<h3>Domande aperte</h3><pre>{{join(1.aperti; \"\\n\")}}</pre>\n<hr>\n<p><a href=\"<<APPROVE_WEBHOOK_URL>>?post_id={{1.post_id}}&decision=approve\">APPROVA e pubblica</a>\n&nbsp;|&nbsp;\n<a href=\"<<APPROVE_WEBHOOK_URL>>?post_id={{1.post_id}}&decision=reject\">RIFIUTA</a></p>\n"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": 0,
                  "name": "Email di revisione"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "email:ActionSendEmail",
              "version": 6,
              "parameters": {
                "account": 0
              },
              "filter": {
                "name": "Payload incompleto",
                "conditions": [
                  [
                    {
                      "a": "{{1.cta_keyword}}",
                      "b": "<",
                      "o": "text:contain"
                    }
                  ]
                ]
              },
              "mapper": {
                "to": [
                  "admin@giusivalentini.com"
                ],
                "subject": "HDH social — bozza NON pubblicabile — {{1.data_post}}",
                "contentType": "html",
                "html": "<p>La bozza <strong>{{1.post_id}}</strong> contiene ancora un segnaposto (<code>{{1.cta_keyword}}</code>). Non è stato inviato nessun link di approvazione.</p><p><a href=\"{{1.canva_design_url}}\">Apri in Canva</a></p>"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": 300,
                  "name": "Blocco segnaposto"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": {
      "orphans": []
    }
  }
}